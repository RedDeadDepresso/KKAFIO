          "pipeline_override": {
            "CombinedArchive": false
          }
        }
      ]
    },
    "IncludeModpack": {
      "type": "switch",
      "label": "$option.IncludeModpack.label",
      "description": "$option.IncludeModpack.description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.IncludeModpack.case.Yes.label",
          "pipeline_override": {
            "IncludeModpack": true
          }
        },
        {
          "name": "No",
          "label": "$option.IncludeModpack.case.No.label",
          "pipeline_override": {
            "IncludeModpack": false
          }
        }
      ]
    },
    "CharaDir": {
      "type": "folder",
      "name": "chara_dir",
      "label": "$option.CharaDir.label",
      "description": "$option.CharaDir.description",
      "default": "",
      "pipeline_override": {
        "CharaDir": "{chara_dir}"
