    "TelegramSource": {
      "type": "select",
      "label": "$option.TelegramSource.label",
      "description": "$option.TelegramSource.description",
      "default_case": "No",
      "cases": [
        {
          "name": "No",
          "label": "$option.TelegramSource.case.No.label",
          "pipeline_override": {
            "TelegramSource": "No"
          }
        },
        {
          "name": "KoikatsuCards",
          "label": "$option.TelegramSource.case.KoikatsuCards.label",
          "pipeline_override": {
            "TelegramSource": "KoikatsuCards"
          }
        },
        {
          "name": "ChatLinks",
          "label": "$option.TelegramSource.case.ChatLinks.label",
          "pipeline_override": {
