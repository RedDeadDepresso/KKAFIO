            "ScanScene": true
          }
        },
        {
          "name": "Coord",
          "label": "$option.ContentTypes.case.Coord.label",
          "pipeline_override": {
            "ScanCoord": true
          }
        }
      ]
    },
    "SideloaderModpack": {
      "type": "select",
      "label": "$option.SideloaderModpack.label",
      "description": "$option.SideloaderModpack.description",
      "default_case": "Skip",
      "cases": [
        {
          "name": "Skip",
          "label": "$option.SideloaderModpack.case.Skip.label",
          "pipeline_override": {
            "SideloaderModpack": "Skip"
          }
        },
        {
          "name": "OnlyUsed",
          "label": "$option.SideloaderModpack.case.OnlyUsed.label",
          "pipeline_override": {
            "SideloaderModpack": "OnlyUsed"
          }
        },
        {
          "name": "All",
          "label": "$option.SideloaderModpack.case.All.label",
          "pipeline_override": {
            "SideloaderModpack": "All"
          }
        }
