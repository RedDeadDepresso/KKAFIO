{
  "interface_version": 2,
  "name": "KKAFIO",
  "label": "$root.label",
  "title": "$root.title",
  "version": "2.1.0",
  "github": "https://github.com/RedDeadDepresso/KKAFIO",
  "mirrorchyan_rid": "",
  "description": "$root.description",
  "icon": "assets/logo.png",
  "agent": {
    "child_exec": "python",
    "child_args": ["kkafio_cli.exe", "run"]
  },
  "controller": [
    {
      "name": "Win32-Game",
      "label": "Koikatsu (Win32)",
      "type": "Win32",
      "win32": {
        "class_regex": "UnityWndClass",
        "window_regex": "Koikatsu"
      }
    }
  ],
  "resource": [
    {
      "name": "default",
      "label": "Default Resources",
      "path": ["."]
    }
  ],
  "option": {
    "GameType": {
      "type": "select",
      "label": "$option.GameType.label",
      "description": "$option.GameType.description",
      "default_case": "Koikatsu",
      "cases": [
        {
          "name": "Koikatsu",
          "label": "$option.GameType.case.Koikatsu.label",
          "pipeline_override": {
            "GameType": "Koikatsu"
          }
        },
        {
          "name": "KoikatsuParty",
          "label": "$option.GameType.case.KoikatsuParty.label",
          "pipeline_override": {
            "GameType": "KoikatsuParty"
          }
        },
        {
          "name": "KoikatsuSunshine",
          "label": "$option.GameType.case.KoikatsuSunshine.label",
          "pipeline_override": {
            "GameType": "KoikatsuSunshine"
          }
        }
      ]
    },
    "GamePath": {
      "type": "folder",
      "name": "game_path",
      "label": "$option.GamePath.label",
      "description": "$option.GamePath.description",
      "default": "C:/Program Files (x86)/Steam/steamapps/common/Koikatsu Party",
      "pipeline_override": {
        "Core": {
          "GamePath": "{game_path}"
        }
      }
    },
    "BackupOutputPath": {
      "type": "folder",
      "name": "backup_output_path",
      "label": "$option.OutputPath.label",
      "description": "$option.OutputPath.description",
      "default": "C:/KKAFIO/Backups",
      "pipeline_override": {
        "OutputPath": "{backup_output_path}"
      }
    },
    "BackupFilename": {
      "type": "input",
      "label": "$option.BackupFilename.label",
      "description": "$option.BackupFilename.description",
      "inputs": [
        {
          "name": "filename",
          "label": "$option.BackupFilename.input.filename.label",
          "default": "koikatsu_backup",
          "pipeline_type": "string"
        }
      ],
      "pipeline_override": {
        "Filename": "{filename}"
      }
    },
    "DownloadOutputDir": {
      "type": "folder",
      "name": "output_dir",
      "label": "$option.DownloadOutputDir.label",
      "description": "$option.DownloadOutputDir.description",
      "default": "C:/KKAFIO/Downloads",
      "pipeline_override": {
        "OutputDir": "{output_dir}"
      }
    },
    "DownloadLinks": {
      "type": "textarea",
      "name": "links",
      "label": "$option.DownloadLinks.label",
      "description": "$option.DownloadLinks.description",
      "placeholder": "https://db.bepis.moe/koikatsu\nhttps://db.bepis.moe/koikatsu | all\nhttps://db.bepis.moe/koikatsu | 1 | 5\nhttps://koikatsucards.com/contents/123\nhttps://koikatsucards.com/cards | 3 | 1",
      "default": "",
      "pipeline_override": {
        "Links": "{links}"
      }
    },
    "SkipDownloaded": {
      "type": "switch",
      "label": "$option.SkipDownloaded.label",
      "description": "$option.SkipDownloaded.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.SkipDownloaded.case.Yes.label",
          "pipeline_override": {
            "SkipDownloaded": true
          }
        },
        {
          "name": "No",
          "label": "$option.SkipDownloaded.case.No.label",
          "pipeline_override": {
            "SkipDownloaded": false
          }
        }
      ]
    },
    "InputPath": {
      "type": "folder",
      "name": "input_path",
      "label": "$option.InputPath.label",
      "description": "$option.InputPath.description",
      "default": "",
      "pipeline_override": {
        "InputPath": "{input_path}"
      }
    },
    "KoiCardTexToolPath": {
      "type": "folder",
      "name": "koi_card_tex_tool_path",
      "label": "KoiCardTexTool Path",
      "description": "Folder containing (or where to install) KoiCardTexTool.exe. If the exe isn't found there, KKAFIO downloads and extracts the latest release automatically before running it.",
      "default": "C:/KoiCardTexTool",
      "pipeline_override": {
        "KoiCardTexToolPath": "{koi_card_tex_tool_path}"
      }
    },
    "DeleteOriginalCards": {
      "type": "switch",
      "label": "Delete Original Cards",
      "description": "After compressing, find every card whose filename ends in [zip] (e.g. CardA[zip].png), and if the original (CardA.png) still exists alongside it, send the original to the Recycle Bin.",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "Delete Originals",
          "pipeline_override": {
            "DeleteOriginalCards": true
          }
        },
        {
          "name": "No",
          "label": "Keep Both",
          "pipeline_override": {
            "DeleteOriginalCards": false
          }
        }
      ]
    },
    "Filter": {
      "type": "switch",
      "label": "$option.Filter.label",
      "description": "$option.Filter.description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.Filter.case.Yes.label",
          "pipeline_override": {
            "Filter": true
          }
        },
        {
          "name": "No",
          "label": "$option.Filter.case.No.label",
          "pipeline_override": {
            "Filter": false
          }
        }
      ]
    },
    "Convert": {
      "type": "switch",
      "label": "$option.Convert.label",
      "description": "$option.Convert.description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.Convert.case.Yes.label",
          "pipeline_override": {
            "Convert": true
          }
        },
        {
          "name": "No",
          "label": "$option.Convert.case.No.label",
          "pipeline_override": {
            "Convert": false
          }
        }
      ]
    },
    "ExtractArchive": {
      "type": "switch",
      "label": "$option.ExtractArchive.label",
      "description": "$option.ExtractArchive.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.ExtractArchive.case.Yes.label",
          "pipeline_override": {
            "ExtractArchive": true
          }
        },
        {
          "name": "No",
          "label": "$option.ExtractArchive.case.No.label",
          "pipeline_override": {
            "ExtractArchive": false
          }
        }
      ]
    },
    "ArchivePassword": {
      "type": "select",
      "label": "$option.ArchivePassword.label",
      "description": "$option.ArchivePassword.description",
      "default_case": "Skip",
      "cases": [
        {
          "name": "Skip",
          "label": "$option.ArchivePassword.case.Skip.label",
          "pipeline_override": {
            "Password": "Skip"
          }
        },
        {
          "name": "Request",
          "label": "$option.ArchivePassword.case.Request.label",
          "pipeline_override": {
            "Password": "Request Password"
          }
        }
      ]
    },
    "FuzzyMatching": {
      "type": "switch",
      "label": "$option.FuzzyMatching.label",
      "description": "$option.FuzzyMatching.description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.FuzzyMatching.case.Yes.label",
          "pipeline_override": {
            "FuzzyChara": true
          }
        },
        {
          "name": "No",
          "label": "$option.FuzzyMatching.case.No.label",
          "pipeline_override": {
            "FuzzyChara": false
          }
        }
      ]
    },
    "KeepStrategy": {
      "type": "select",
      "label": "$option.KeepStrategy.label",
      "description": "$option.KeepStrategy.description",
      "default_case": "Biggest file size",
      "cases": [
        {
          "name": "None",
          "label": "$option.KeepStrategy.case.None.label"
        },
        {
          "name": "Newest",
          "label": "$option.KeepStrategy.case.Newest.label"
        },
        {
          "name": "Oldest",
          "label": "$option.KeepStrategy.case.Oldest.label"
        },
        {
          "name": "Biggest file size",
          "label": "$option.KeepStrategy.case.Biggest file size.label"
        },
        {
          "name": "Smallest file size",
          "label": "$option.KeepStrategy.case.Smallest file size.label"
        },
        {
          "name": "Last alphabetically",
          "label": "$option.KeepStrategy.case.Last alphabetically.label"
        },
        {
          "name": "First alphabetically",
          "label": "$option.KeepStrategy.case.First alphabetically.label"
        }
      ],
      "pipeline_override": {
        "Keep": "{case.name}"
      }
    },
    "DuplicateAction": {
      "type": "select",
      "label": "$option.DuplicateAction.label",
      "description": "$option.DuplicateAction.description",
      "default_case": "Move & Rename",
      "cases": [
        {
          "name": "Move & Rename",
          "label": "$option.DuplicateAction.case.Move & Rename.label"
        },
        {
          "name": "Move",
          "label": "$option.DuplicateAction.case.Move.label"
        },
        {
          "name": "Delete",
          "label": "$option.DuplicateAction.case.Delete.label"
        }
      ],
      "pipeline_override": {
        "DuplicateAction": "{case.name}"
      }
    },
    "InstallContentTypes": {
      "type": "checkbox",
      "label": "$option.InstallContentTypes.label",
      "description": "$option.InstallContentTypes.description",
      "default_case": ["Chara", "Mods", "Coords", "Scenes", "Overlays"],
      "cases": [
        {
          "name": "Chara",
          "label": "$option.InstallContentTypes.case.Chara.label",
          "pipeline_override": {
            "Chara": true
          }
        },
        {
          "name": "Mods",
          "label": "$option.InstallContentTypes.case.Mods.label",
          "pipeline_override": {
            "Mods": true
          }
        },
        {
          "name": "Coords",
          "label": "$option.InstallContentTypes.case.Coords.label",
          "pipeline_override": {
            "Coords": true
          }
        },
        {
          "name": "Scenes",
          "label": "$option.InstallContentTypes.case.Scenes.label",
          "pipeline_override": {
            "Scenes": true
          }
        },
        {
          "name": "Overlays",
          "label": "$option.InstallContentTypes.case.Overlays.label",
          "pipeline_override": {
            "Overlays": true
          }
        }
      ]
    },
    "FileConflicts": {
      "type": "select",
      "label": "$option.FileConflicts.label",
      "description": "$option.FileConflicts.description",
      "default_case": "Skip",
      "cases": [
        {
          "name": "Skip",
          "label": "$option.FileConflicts.case.Skip.label",
          "pipeline_override": {
            "FileConflicts": "Skip"
          }
        },
        {
          "name": "Replace",
          "label": "$option.FileConflicts.case.Replace.label",
          "pipeline_override": {
            "FileConflicts": "Replace"
          }
        },
        {
          "name": "Rename",
          "label": "$option.FileConflicts.case.Rename.label",
          "pipeline_override": {
            "FileConflicts": "Rename"
          }
        }
      ]
    },
    "RenameCharaPrompt": {
      "type": "textarea",
      "name": "prompt",
      "label": "$option.RenameCharaPrompt.label",
      "description": "$option.RenameCharaPrompt.description",
      "default": "You will receive a JSON object whose keys identify Koikatsu character card files.\nEach key has the format:  name | personality | hair_color\n\nYour task: for every key fill in \"lastname\", \"firstname\", and \"nickname\" with the\ncharacter's well-known English name.\n\nRules:\n- Use Western name order: firstname = given name, lastname = family name.\n- Use the English name the character is commonly known by, not a literal\n  transliteration (e.g. lastname \"Tohsaka\" firstname \"Rin\", not \"Tosaka Rin\").\n- \"nickname\" can be a common short form or the same as firstname.\n- Use the personality and hair colour as additional hints to identify the character.\n- All values must be valid Windows filenames\n  (no  \\ / : * ? \" < > |  characters, no leading/trailing spaces or dots).\n- If you do not recognise the character or are not confident, leave all three\n  fields as empty strings \"\".\n- Return ONLY the completed JSON object — no explanation, no markdown fences,\n  no extra text before or after.\n\nJSON to fill in:\n",
      "pipeline_override": {
        "Prompt": "{prompt}"
      }
    },
    "SkipAlreadyRenamed": {
      "type": "switch",
      "label": "$option.SkipAlreadyRenamed.label",
      "description": "$option.SkipAlreadyRenamed.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.SkipAlreadyRenamed.case.Yes.label",
          "pipeline_override": {
            "SkipAlreadyRenamed": true
          }
        },
        {
          "name": "No",
          "label": "$option.SkipAlreadyRenamed.case.No.label",
          "pipeline_override": {
            "SkipAlreadyRenamed": false
          }
        }
      ]
    },
    "UpdateMetadata": {
      "type": "switch",
      "label": "$option.UpdateMetadata.label",
      "description": "$option.UpdateMetadata.description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.UpdateMetadata.case.Yes.label",
          "pipeline_override": {
            "UpdateMetadata": true
          }
        },
        {
          "name": "No",
          "label": "$option.UpdateMetadata.case.No.label",
          "pipeline_override": {
            "UpdateMetadata": false
          }
        }
      ]
    },
    "RenameFiles": {
      "type": "switch",
      "label": "$option.RenameFiles.label",
      "description": "$option.RenameFiles.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.RenameFiles.case.Yes.label",
          "pipeline_override": {
            "RenameFiles": true
          }
        },
        {
          "name": "No",
          "label": "$option.RenameFiles.case.No.label",
          "pipeline_override": {
            "RenameFiles": false
          }
        }
      ]
    },
    "GroupCharaPrompt": {
      "type": "textarea",
      "name": "prompt",
      "label": "$option.GroupCharaPrompt.label",
      "description": "$option.GroupCharaPrompt.description",
      "placeholder": "You will receive a JSON object whose keys identify Koikatsu character card files…",
      "default": "You will receive a JSON object whose keys identify Koikatsu character card files.\nEach key has the format:  name | personality | hair_color\n\nYour task: for every key, write the name of the anime/game series the character is from as the value.\n\nRules:\n- Values must be valid Windows folder names (no  \\ / : * ? \" < > |  characters).\n- Use the official English title of the series.\n- If a character appears in multiple series, use the one they are most associated with.\n- Use the personality and hair colour as additional hints to identify the character.\n- If you are not sure or the character is an original creation, leave the value as an empty string \"\".\n- Return ONLY the completed JSON object — no explanation, no markdown code fences, no extra text before or after.\n\nJSON to fill in:\n",
      "pipeline_override": {
        "Prompt": "{prompt}"
      }
    },
    "GroupCharaIncludeSubfolders": {
      "type": "switch",
      "label": "$option.GroupCharaIncludeSubfolders.label",
      "description": "$option.GroupCharaIncludeSubfolders.description",
      "default_case": "No",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.GroupCharaIncludeSubfolders.case.Yes.label",
          "pipeline_override": {
            "IncludeSubfolders": true
          }
        },
        {
          "name": "No",
          "label": "$option.GroupCharaIncludeSubfolders.case.No.label",
          "pipeline_override": {
            "IncludeSubfolders": false
          }
        }
      ]
    },
    "DeleteEmptyFolders": {
      "type": "switch",
      "label": "$option.DeleteEmptyFolders.label",
      "description": "$option.DeleteEmptyFolders.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.DeleteEmptyFolders.case.Yes.label",
          "pipeline_override": {
            "DeleteEmptyFolders": true
          }
        },
        {
          "name": "No",
          "label": "$option.DeleteEmptyFolders.case.No.label",
          "pipeline_override": {
            "DeleteEmptyFolders": false
          }
        }
      ]
    },
    "ArchiveFormat": {
      "type": "select",
      "label": "$option.ArchiveFormat.label",
      "description": "$option.ArchiveFormat.description",
      "default_case": "7z",
      "cases": [
        {
          "name": "7z",
          "label": "$option.ArchiveFormat.case.7z.label"
        },
        {
          "name": "zip",
          "label": "$option.ArchiveFormat.case.zip.label"
        }
      ],
      "pipeline_override": {
        "Format": "{case.name}"
      }
    },
    "CombinedArchive": {
      "type": "switch",
      "label": "$option.CombinedArchive.label",
      "description": "$option.CombinedArchive.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.CombinedArchive.case.Yes.label",
          "pipeline_override": {
            "CombinedArchive": true
          }
        },
        {
          "name": "No",
