    },
    "SceneDir": {
      "type": "folder",
      "name": "scene_dir",
      "label": "$option.SceneDir.label",
      "description": "$option.SceneDir.description",
      "default": "",
      "pipeline_override": {
        "SceneDir": "{scene_dir}"
      }
    },
    "CoordDir": {
      "type": "folder",
      "name": "coord_dir",
      "label": "$option.CoordDir.label",
      "description": "$option.CoordDir.description",
      "default": "",
      "pipeline_override": {
        "CoordDir": "{coord_dir}"
      }
    },
    "ContentTypes": {
      "type": "checkbox",
      "label": "$option.ContentTypes.label",
      "description": "$option.ContentTypes.description",
      "default_case": ["Chara", "Scene", "Coord"],
      "cases": [
        {
          "name": "Chara",
          "label": "$option.ContentTypes.case.Chara.label",
