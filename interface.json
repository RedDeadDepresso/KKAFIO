    "RenameToGuid": {
      "type": "switch",
      "label": "$option.RenameToGuid.label",
      "description": "$option.RenameToGuid.description",
      "default_case": "Yes",
      "cases": [
        {
          "name": "Yes",
          "label": "$option.RenameToGuid.case.Yes.label",
          "pipeline_override": {
            "RenameToGuid": true
          }
        },
        {
          "name": "No",
          "label": "$option.RenameToGuid.case.No.label",
          "pipeline_override": {
            "RenameToGuid": false
          }
